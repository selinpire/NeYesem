{
  "expo": {
    "name": "NeYesem Mobile",
    "slug": "neyesem-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f7f4ee"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f4ee"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
